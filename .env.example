# MySQL 8.0.16+ (8.4 LTS recommended). No embedded database fallback.
# Prefer individual settings so special characters in passwords need no URL encoding.
# Supply MYSQL_PASSWORD through the process environment or a secret manager, not a file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_DATABASE=harmony
# Optional alternative mysql:// URL. Overrides the individual MYSQL_* settings.
# URL passwords must be percent-encoded. Never commit a URL containing credentials.
DATABASE_URL=
# Absolute durable file directory. Defaults to <project>/.data (files at .data/uploads).
DATA_DIR=
# Optional absolute PDF directory. Defaults to <DATA_DIR>/uploads.
UPLOAD_DIR=
# Required in production to enable the one-time initial administrator setup.
SETUP_TOKEN=
# Required in production. Generate a random value of at least 32 characters.
BETTER_AUTH_SECRET=
# Public application URL, e.g. https://music.example.org
APP_URL=http://127.0.0.1:3000
# SMTP is required outside development. Password reset and verification mail are not logged in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
